# Sprout automatically uses the live stack only when BOTH Supabase and Claude
# are configured and healthy. Otherwise it falls back to the local demo.

# Claude (server only). ANTHROPIC_MODEL is optional; the code defaults to
# claude-sonnet-4-5, but an explicit model available to your account is best.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase. The service-role key must NEVER use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# auto | demo/supabase and auto | seeded/claude
# Keep auto to use live services when available and fall back when they fail.
SPROUT_DATA_MODE=auto
SPROUT_AI_MODE=auto
