# Sprout Auth turns on when its public Supabase values are configured.
# The persistent verification stack uses both Supabase and Claude; otherwise
# mission verification falls back to the local demo.

# Claude (server only). ANTHROPIC_MODEL is optional; the code defaults to
# claude-sonnet-4-5, but an explicit model available to your account is best.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase Auth uses the public URL/key in browser and server cookie clients.
# The service-role key stays server-only; it creates confirmed username accounts
# and performs private profile/evidence writes. Never use a NEXT_PUBLIC_ prefix
# for the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# auto | demo/supabase and auto | seeded/claude
# Keep auto to use live services when available and fall back when they fail.
SPROUT_DATA_MODE=auto
SPROUT_AI_MODE=auto
